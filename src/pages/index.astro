---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/Button.astro';
import SectionHead from '../components/SectionHead.astro';
import Preview from '../components/Preview.astro';
---

<Base
  title="Akintayo Akinnibosun — Frontend Developer"
  description="Frontend developer who designs and builds fast, beautiful sites for indie makers."
>
  <Nav onHome />

  <main id="top">
    <!-- ============ HERO ============ -->
    <section class="hero wrap">
      <p class="eyebrow">Frontend developer · design + build</p>
      <h1>I design and build sites indie makers are <span class="mute">proud to ship.</span></h1>
      <p class="hero-lede">I take rough launch pages and turn them into fast, beautiful sites that actually convert — designed and built end to end.</p>
      <div class="hero-actions">
        <Button href="#work" variant="primary">View the work</Button>
        <Button href="#contact" variant="ghost">Get in touch</Button>
      </div>
    </section>

    <!-- ============ WORK ============ -->
    <section class="section wrap" id="work">
      <SectionHead num="01" title="Selected work" />

      <div class="work-grid single">
        <a class="case-card" href="/work/centre-for-earthworks">
          <div class="stage">
            <Preview url="centreforearthworks.org" aspect="tall" />
          </div>
          <div class="case-meta">
            <div>
              <h3>Centre for Earthworks</h3>
              <div class="case-kind">Environmental NGO · performance + accessibility rebuild</div>
            </div>
          </div>
          <p>An environmental NGO's site took about eleven seconds to show anything on the phones its audience actually uses. I rebuilt it to appear in two.</p>
          <span class="case-link">Read case study <span class="arrow">↗</span></span>
        </a>
      </div>
    </section>

    <!-- ============ ABOUT ============ -->
    <section class="section wrap" id="about">
      <SectionHead num="02" title="About" />

      <div class="about-grid">
        <div>
          <p class="about-lede">I’m a frontend developer who designs as well as builds — so the site you launch is the site you imagined.</p>
          <div class="about-body">
            <p>Most makers I work with are technical, time-poor, and stuck with a homepage that doesn’t do their product justice. I step in for the part that isn’t their craft: turning a vague idea of “it should look good” into a clear, fast, considered site.</p>
            <p>I work end to end — layout, type, motion, and the actual responsive build — so nothing gets lost in a handoff. No templates, no page-builder bloat. Just a site that loads quickly, reads clearly, and feels like it was made on purpose.</p>
          </div>
          <div class="about-tools">
            <span class="chip">HTML &amp; CSS</span>
            <span class="chip">TypeScript</span>
            <span class="chip">React</span>
            <span class="chip">Astro</span>
            <span class="chip">Motion design</span>
            <span class="chip">Accessibility</span>
            <span class="chip">Performance</span>
          </div>
        </div>
        <div class="about-portrait"><span class="shot-tag">portrait — Akintayo</span></div>
      </div>
    </section>

    <!-- ============ EXPERIENCE ============ -->
    <section class="section wrap" id="experience">
      <SectionHead num="03" title="Experience" />

      <div class="exp-list">
        <div class="exp-row">
          <div class="exp-yr">2024 — now</div>
          <div>
            <div class="exp-role">Independent — design &amp; build for indie makers</div>
            <div class="exp-note">Fast, considered sites shipped in two to four weeks</div>
          </div>
        </div>
        <div class="exp-row placeholder">
          <div class="exp-yr">————</div>
          <div>
            <div class="exp-role">Your real roles go here</div>
            <div class="exp-note">Send me your actual history and I’ll slot it in — no invented companies.</div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ CONTACT ============ -->
    <Footer>
      <h2>Have a site that deserves better?</h2>
      <a class="contact-email" href="mailto:hello@akintayo.dev">hello@akintayo.dev</a>
    </Footer>
  </main>
</Base>
